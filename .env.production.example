# Copy to .env.production on the deployment host and replace every placeholder.
# Never commit .env.production or paste these values into an issue, lab, or chat.

APEX_WEB_DOMAIN=apex.example.edu
APEX_DB_NAME=apex_facilities
APEX_DB_ADMIN_USER=apex_admin
APEX_DB_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

# Opaque 8-24 character lowercase alias. Do not use a name, email, or student ID.
APEX_PREVIEW_ALIAS=preview01
APEX_PREVIEW_PASSWORD=replace-with-a-different-long-preview-password

# Optional host resource limits. Adjust only after measuring the VPS.
APEX_DB_MEMORY_LIMIT=2g
APEX_APP_MEMORY_LIMIT=1g
APEX_CADDY_MEMORY_LIMIT=256m
