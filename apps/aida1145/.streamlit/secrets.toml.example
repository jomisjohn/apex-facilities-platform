# Copy this file to `.streamlit/secrets.toml` and replace every placeholder.
# Never commit the copied secrets.toml file.

[connections.apex]
dialect = "postgresql"
driver = "psycopg"
host = "YOUR_DATABASE_HOST"
port = 5432
database = "apex_facilities"
username = "YOUR_ASSIGNED_DATABASE_USER"
password = "YOUR_ASSIGNED_DATABASE_PASSWORD"

[connections.apex.create_engine_kwargs]
pool_pre_ping = true
pool_recycle = 1800

[apex]
# Use the exact course workspace schema assigned to you.
workspace_schema = "ws_aida1145_example01"
