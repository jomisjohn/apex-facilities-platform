{
	admin 127.0.0.1:2019
}

{$APEX_WEB_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:8501
}

# ACME HTTP-01 webroot for the separately managed PostgreSQL certificate.
http://{$APEX_DB_DOMAIN:db.invalid} {
	handle /.well-known/acme-challenge/* {
		root * /srv/acme
		file_server
	}
	respond 404
}
