[Unit]
Description=Renew and reload the Apex PostgreSQL TLS certificate
Documentation=https://github.com/jomisjohn/apex-facilities-platform
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/opt/apex-facilities-platform/.env.production

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/apex-facilities-platform
ExecStart=/opt/apex-facilities-platform/deploy/database/manage-db-certificate.sh renew /opt/apex-facilities-platform/.env.production
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
